# Local development — copy to .env.local and fill secrets.
# Prefer localhost Postgres so Railway restarts cannot drop players.poolKey.
#
# Option A (Docker):  docker compose up -d
# Option B (native):  local Postgres 17 with user/db/password below (see README)

# Active DB for `npm run dev` / prisma (local)
DATABASE_URL="postgresql://lineup:lineupdev@localhost:5432/lineup?schema=public"

# Optional: keep the Railway URL here for rare one-off ops (never use as active DATABASE_URL while developing)
# DATABASE_URL_RAILWAY="postgresql://USER:PASS@HOST.proxy.rlwy.net:PORT/railway"

# Auth / OAuth (same as production, local-only values OK)
# NEXTAUTH_URL="http://localhost:3000"
# NEXTAUTH_SECRET="dev-secret-change-me"

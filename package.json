{
  "name": "hockey-nomination-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "predev": "node scripts/ensure-lineup-db.mjs",
    "dev": "next dev -p 3000",
    "dev:clean": "node -e \"try{require('fs').rmSync('.next/dev',{recursive:true,force:true})}catch(e){}\" && next dev -p 3000",
    "build": "prisma generate && next build",
    "start": "node scripts/ensure-lineup-db.mjs && next start --hostname 0.0.0.0",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:push": "node scripts/prisma-with-env.mjs db push",
    "db:ensure": "node scripts/ensure-lineup-db.mjs",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate:deploy": "node scripts/prisma-with-env.mjs migrate deploy",
    "db:seed": "npx ts-node -r tsconfig-paths/register --project scripts/tsconfig.json prisma/seed.ts",
    "inject:league": "npx ts-node --project scripts/tsconfig.json scripts/inject-league-json.ts",
    "sort:candidates": "npx ts-node --project scripts/tsconfig.json scripts/sort-ms-candidates.ts",
    "stats:extraliga": "node scripts/extraliga-coverage.mjs",
    "scrape:elh": "python scripts/scrape-elh-hokej.py --seasons 2025,2024,2023,2022 --with-l10 --export-xlsx",
    "scrape:elh:stats": "python scripts/scrape-elh-hokej.py --seasons 2025,2024,2023,2022 --export-xlsx",
    "scrape:elh:rosters": "python scripts/scrape-elh-livesport-rosters.py --export-xlsx",
    "scrape:elh:rematch-stats": "python scripts/rematch-elh-stats-to-roster.py --export-xlsx",
    "scrape:elh:livesport-stats": "python scripts/scrape-elh-livesport-stats.py --export-xlsx",
    "enrich:elh:roles": "python scripts/enrich-elh-roles-from-ms.py --export-xlsx",
    "enrich:elh:ep-roles": "python scripts/enrich-elh-roles-from-eliteprospects.py --export-xlsx",
    "build:national-xlsx": "python scripts/build-czech-national-players-xlsx.py",
    "export:lineup-pools-json": "python scripts/export-lineup-pools-json.py",
    "import:lineup-pools": "python scripts/export-lineup-pools-json.py && npx ts-node -r tsconfig-paths/register --project scripts/tsconfig.json scripts/import-lineup-pools.ts",
    "backfill:match-share-repre-a": "npx ts-node -r tsconfig-paths/register --project scripts/tsconfig.json scripts/backfill-match-share-pool-repre-a.ts",
    "merge:elh:ms-editor": "python scripts/merge-elh-czechs-into-ms-editor.py",
    "promo:capture-squad": "node scripts/capture-promo-squad.cjs",
    "og:pad-top": "node scripts/pad-og-top.mjs",
    "email:broadcast": "node scripts/resend-broadcast.mjs",
    "email:contest-results": "npx ts-node -r tsconfig-paths/register --project scripts/tsconfig.json scripts/send-contest-results-email.ts",
    "email:fantasy-results": "npx ts-node -r tsconfig-paths/register --project scripts/tsconfig.json scripts/send-fantasy-results-email.ts",
    "email:daily-fantasy-promo": "npx ts-node -r tsconfig-paths/register --project scripts/tsconfig.json scripts/send-daily-fantasy-promo-email.ts",
    "verify:scoring": "npx ts-node -r tsconfig-paths/register --project scripts/tsconfig.json scripts/verify-contest-scoring.ts",
    "preview:leaderboard": "npx ts-node -r tsconfig-paths/register --project scripts/tsconfig.json scripts/preview-contest-leaderboard.ts",
    "fantasy:import-fin-ger": "npx ts-node --project scripts/tsconfig.json scripts/import-ms-fantasy-roster-teams.ts",
    "fantasy:import-swe": "npx ts-node --project scripts/tsconfig.json scripts/import-ms-fantasy-roster-teams.ts SWE",
    "fantasy:import-tier-rebalance": "npx ts-node --project scripts/tsconfig.json scripts/import-ms-fantasy-roster-teams.ts ITA,FIN,SWE,SUI",
    "fantasy:patch-tier": "npx ts-node --project scripts/tsconfig.json scripts/patch-ms-fantasy-tier.ts",
    "fantasy:patch-aut": "npx ts-node --project scripts/tsconfig.json scripts/patch-ms-fantasy-aut-roster.ts",
    "fantasy:patch-den": "npx ts-node --project scripts/tsconfig.json scripts/patch-ms-fantasy-den-roster.ts",
    "fantasy:patch-usa": "npx ts-node --project scripts/tsconfig.json scripts/patch-ms-fantasy-usa-roster.ts",
    "fantasy:patch-sui": "npx ts-node --project scripts/tsconfig.json scripts/patch-ms-fantasy-sui-roster.ts",
    "fantasy:patch-fin": "npx ts-node --project scripts/tsconfig.json scripts/patch-ms-fantasy-fin-roster.ts",
    "fantasy:patch-ger": "npx ts-node --project scripts/tsconfig.json scripts/patch-ms-fantasy-ger-roster.ts",
    "fantasy:patch-lat": "npx ts-node --project scripts/tsconfig.json scripts/patch-ms-fantasy-lat-roster.ts",
    "fantasy:patch-hun": "npx ts-node --project scripts/tsconfig.json scripts/patch-ms-fantasy-hun-roster.ts",
    "fantasy:patch-gbr": "npx ts-node --project scripts/tsconfig.json scripts/patch-ms-fantasy-gbr-roster.ts",
    "fantasy:patch-swe": "npx ts-node --project scripts/tsconfig.json scripts/patch-ms-fantasy-swe-roster.ts",
    "fantasy:patch-svk": "npx ts-node --project scripts/tsconfig.json scripts/patch-ms-fantasy-svk-roster.ts",
    "fantasy:patch-nor": "npx ts-node --project scripts/tsconfig.json scripts/patch-ms-fantasy-nor-roster.ts",
    "fantasy:patch-slo": "npx ts-node --project scripts/tsconfig.json scripts/patch-ms-fantasy-slo-roster.ts",
    "fantasy:patch-ita": "npx ts-node --project scripts/tsconfig.json scripts/patch-ms-fantasy-ita-roster.ts",
    "fantasy:deactivate": "npx ts-node --project scripts/tsconfig.json scripts/patch-ms-fantasy-deactivate-player.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/adapter-pg": "^6.9.0",
    "@prisma/client": "^6.9.0",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.3.1",
    "framer-motion": "^12.38.0",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.8.0",
    "lz-string": "^1.5.0",
    "next": "16.1.6",
    "next-auth": "^4.24.13",
    "pg": "^8.20.0",
    "prisma": "^6.9.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/lz-string": "^1.3.34",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "playwright": "^1.51.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5"
  }
}
